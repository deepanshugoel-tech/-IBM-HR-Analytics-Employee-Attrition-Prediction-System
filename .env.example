# Copy to backend/.env for LOCAL runs only. Never upload the real .env to GitHub.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false            # set true on the deployed https site
HR_INVITE_CODE=choose-a-secret-code   # needed to register an HR account
HR_ACCESS_CODE=demo123
# DATABASE_URL=postgresql://user:password@host/dbname   # hosted DB = accounts never disappear
# BOOTSTRAP_HR_EMAIL=hr@example.com      # optional: HR account auto-created at every start
# BOOTSTRAP_HR_PASSWORD=ChangeMe#12345
# BOOTSTRAP_HR_NAME=HR Admin
# ENABLE_DOCS=false
# ALLOWED_ORIGINS=             # only if frontend is hosted on a different domain
